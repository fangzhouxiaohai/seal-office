  "steps": [
    {
      "id": "navigation",
      "index": 0,
      "title": "从服务页找到工具",
      "chapter": "01 功能入口",
      "narration": "移动端底部是首页、云盘、服务、模板和我的五个功能页。点击服务，在搜索框输入脑图，就能找到对应入口。",
      "startFrame": 0,
      "endFrame": 248,
      "start": 0,
      "end": 12.4,
      "audio": "android-navigation.mp3",
      "audioSeconds": 10.68,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-navigation-verified.png",
      "endScreenshotSha256": "eb57673ff7af848cb699cd4d4a24e0a3bfbabe45a104ead9f9afc0f8eaf94737"
    },
    {
      "id": "new-word",
      "index": 1,
      "title": "新建文字文档",
      "chapter": "02 文字与保存",
      "narration": "返回首页，进入服务页，选择文字。打开后直接输入标题和正文，当前输入区会显示紫色轮廓。",
      "startFrame": 248,
      "endFrame": 470,
      "start": 12.4,
      "end": 23.5,
      "audio": "android-new-word.mp3",
      "audioSeconds": 9.384,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-new-word-verified.png",
      "endScreenshotSha256": "5b2e58516fccc2e89260c990690ec332ef5b61bb3068c69539862a7d49c2a814"
    },
    {
      "id": "word-body",
      "index": 2,
      "title": "逐字填写工作计划",
      "chapter": "02 文字与保存",
      "narration": "先写每周工作计划，再逐段填写资料整理、预算核对和交付安排。这里展示的输入都实际写入文档。",
      "startFrame": 470,
      "endFrame": 738,
      "start": 23.5,
      "end": 36.9,
      "audio": "android-word-body.mp3",
      "audioSeconds": 9.648,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-word-body-verified.png",
      "endScreenshotSha256": "b21258de18376008cf8d585bc2045c00f128ce65aa2894afa23426d22f48cdf8"
    },
    {
      "id": "word-save",
      "index": 3,
      "title": "保存海豹文字文件",
      "chapter": "02 文字与保存",
      "narration": "点击保存，将这份计划保存为海豹文字格式。保存后仍可继续编辑，文件内容和当前格式一起保留。",
      "startFrame": 738,
      "endFrame": 972,
      "start": 36.9,
      "end": 48.6,
      "audio": "android-word-save.mp3",
      "audioSeconds": 9.96,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-word-save-verified.png",
      "endScreenshotSha256": "bf57c24a660d46123d4c4bcdcbdf784d0176170e066f0d9c406d2e104479be04"
    },
    {
      "id": "reading-enter",
      "index": 4,
      "title": "进入隐藏工具栏的阅读模式",
      "chapter": "03 全屏阅读",
      "narration": "打开准备好的长文档，点击全屏阅读。进入后顶部和底部操作栏默认隐藏，页面空间留给正文。",
      "startFrame": 972,
      "endFrame": 1190,
      "start": 48.6,
      "end": 59.5,
      "audio": "android-reading-enter.mp3",
      "audioSeconds": 9.168,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-reading-enter-verified.png",
      "endScreenshotSha256": "2af9a2cdf53984a61e6addd20c4b757b42cb83c786f46d567874d73997b8a765"
    },
    {
      "id": "reading-swipe",
      "index": 5,
      "title": "左右滑动翻页",
      "chapter": "03 全屏阅读",
      "narration": "在正文中向左滑动，切换到下一页；向右滑动可以返回上一页。紫色轮廓标出当前阅读区域。",
      "startFrame": 1190,
      "endFrame": 1403,
      "start": 59.5,
      "end": 70.15,
      "audio": "android-reading-swipe.mp3",
      "audioSeconds": 8.928,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-reading-swipe-verified.png",
      "endScreenshotSha256": "57a947bab4072de5e1f64296b8cb9e338a5462e6e23958b21271b8a4d607a648"
    },
    {
      "id": "reading-controls",
      "index": 6,
      "title": "双击唤出，三秒后收起",
      "chapter": "03 全屏阅读",
      "narration": "双击页面，唤出顶部和底部工具栏。停止操作约三秒后，工具栏自动收起，继续专心阅读。",
      "startFrame": 1403,
      "endFrame": 1615,
      "start": 70.15,
      "end": 80.75,
      "audio": "android-reading-controls.mp3",
      "audioSeconds": 8.856,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-reading-controls-verified.png",
      "endScreenshotSha256": "d44cc6f814035605b4f1833ca3486df57a87748cba2d8b42756bd4fd19d6e350"
    },
    {
      "id": "reading-zoom",
      "index": 7,
      "title": "双指缩放阅读内容",
      "chapter": "03 全屏阅读",
      "narration": "双指向外展开，放大阅读内容。需要退出时，再双击页面唤出工具栏，点击返回，回到原文档。",
      "startFrame": 1615,
      "endFrame": 1843,
      "start": 80.75,
      "end": 92.15,
      "audio": "android-reading-zoom.mp3",
      "audioSeconds": 9.432,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-reading-zoom-verified.png",
      "endScreenshotSha256": "a9de55545350fc03cf0041a3cbca53ab059048cea3d6b4b761a3345d3dfc7cae"
    },
    {
      "id": "assistant-drag",
      "index": 8,
      "title": "拖动海豹 Logo 悬浮球",
      "chapter": "04 海豹助手",
      "narration": "智能助手现在使用海豹办公标志。按住圆形悬浮球拖动，松手后停在新位置，再点击打开大窗口。",
      "startFrame": 1843,
      "endFrame": 2071,
      "start": 92.15,
      "end": 103.55,
      "audio": "android-assistant-drag.mp3",
      "audioSeconds": 9.696,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-assistant-drag-verified.png",
      "endScreenshotSha256": "4774794f2bfba99876bf795eabb398b3330dfd289f422438f8fa3e3e21181b58"
    },
    {
      "id": "assistant-modes",
      "index": 9,
      "title": "区分对话和工作模式",
      "chapter": "04 海豹助手",
      "narration": "目标文件默认是当前文档。对话模式只回答问题；工作模式可以提出文档修改，先预览确认。使用生成式功能前，需要登录已验证的账号。",
      "startFrame": 2071,
      "endFrame": 2367,
      "start": 103.55,
      "end": 118.35,
      "audio": "android-assistant-modes.mp3",
      "audioSeconds": 13.08,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-assistant-modes-verified.png",
      "endScreenshotSha256": "6356e6e4c6239c9d2454c7cdc1028a4baaded0fae496381f76ff8c2bf72b00d6"
    },
    {
      "id": "sheet-open",
      "index": 10,
      "title": "打开项目预算表",
      "chapter": "05 表格与目标文件",
      "narration": "先关闭助手，回到首页，导入项目预算表。文字和表格可以同时保留在已打开的文件标签中。",
      "startFrame": 2367,
      "endFrame": 2578,
      "start": 118.35,
      "end": 128.9,
      "audio": "android-sheet-open.mp3",
      "audioSeconds": 8.808,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-sheet-open-verified.png",
      "endScreenshotSha256": "869e47ce478dbaad9b55f3993e47aeba05864bfc26aa61fbd9bcef49c250e5d2"
    },
    {
      "id": "sheet-formula",
      "index": 11,
      "title": "在手机上输入公式",
      "chapter": "05 表格与目标文件",
      "narration": "选中 D 五，在公式栏输入求和公式，按回车。合计显示两千三百六十，接着可以保存或继续编辑。",
      "startFrame": 2578,
      "endFrame": 2826,
      "start": 128.9,
      "end": 141.3,
      "audio": "android-sheet-formula.mp3",
      "audioSeconds": 9.72,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-sheet-formula-verified.png",
      "endScreenshotSha256": "aa2bab8e9f4d3aa12a58edc279326a16bd9e4028005ab5e9c5155c39735bcc81"
    },
    {
      "id": "assistant-target",
      "index": 12,
      "title": "切换助手的目标文件",
      "chapter": "05 表格与目标文件",
      "narration": "再次打开助手，展开目标文件列表。选择工作计划，切换到对话模式，就能围绕指定的文件提问。",
      "startFrame": 2826,
      "endFrame": 3054,
      "start": 141.3,
      "end": 152.7,
      "audio": "android-assistant-target.mp3",
      "audioSeconds": 9.096,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/android-assistant-target-verified.png",
      "endScreenshotSha256": "96be79fb886eea0c70561920430b6c62f496b4febbedcd8f7493074ff826d4a6"
    },
    {
      "id": "templates",
      "index": 13,
