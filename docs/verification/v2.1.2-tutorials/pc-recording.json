  "steps": [
    {
      "id": "new-word",
      "index": 0,
      "title": "新建一份工作计划",
      "chapter": "01 文字与专属格式",
      "narration": "先从首页点击新建，选择文字文档。下面从一份空白文档开始，完成输入、保存和重新打开。",
      "startFrame": 0,
      "endFrame": 216,
      "start": 0,
      "end": 10.8,
      "audio": "pc-new-word.mp3",
      "audioSeconds": 9.072,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/pc-new-word-verified.png",
      "endScreenshotSha256": "de71027d7e81d064a9ffb564de4045dc8c30689d99e9f72f12c64e9c8f447036"
    },
    {
      "id": "word-title",
      "index": 1,
      "title": "输入标题",
      "chapter": "01 文字与专属格式",
      "narration": "点击正文，输入每周工作计划，按回车开始下一段。输入位置会显示紫色轮廓，鼠标点击也有圆环提示。",
      "startFrame": 216,
      "endFrame": 452,
      "start": 10.8,
      "end": 22.6,
      "audio": "pc-word-title.mp3",
      "audioSeconds": 10.08,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/pc-word-title-verified.png",
      "endScreenshotSha256": "01fc78f3463a4f41e8d7591488aa788898a609d20d9deb7a3c554f29f9b70db0"
    },
    {
      "id": "word-body",
      "index": 2,
      "title": "填写计划内容",
      "chapter": "01 文字与专属格式",
      "narration": "继续输入本周目标和具体安排。文字会随着输入逐字出现；需要修改时，把光标放回正文即可继续编辑。",
      "startFrame": 452,
      "endFrame": 689,
      "start": 22.6,
      "end": 34.45,
      "audio": "pc-word-body.mp3",
      "audioSeconds": 10.104,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/pc-word-body-verified.png",
      "endScreenshotSha256": "c23552269f10a57a2099f96ab5864a91f0b94f04210623c348fdf3ad1c6e9453"
    },
    {
      "id": "word-save",
      "index": 3,
      "title": "保存为 SLDOC",
      "chapter": "01 文字与专属格式",
      "narration": "点击保存，使用海豹文字格式保存当前内容。文件标签会显示 S L D O C 后缀，保存完成后修改标记消失。",
      "startFrame": 689,
      "endFrame": 939,
      "start": 34.45,
      "end": 46.95,
      "audio": "pc-word-save.mp3",
      "audioSeconds": 10.752,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/pc-word-save-verified.png",
      "endScreenshotSha256": "e38a4804c51588fee29a918b743f7d9dc51a87e84ab87bcae380f84eaa81320d"
    },
    {
      "id": "word-reopen",
      "index": 4,
      "title": "关闭后重新打开",
      "chapter": "01 文字与专属格式",
      "narration": "关闭已经保存的文件，再从首页打开同一份文档。标题和正文仍然保留，可以继续编辑。",
      "startFrame": 939,
      "endFrame": 1138,
      "start": 46.95,
      "end": 56.9,
      "audio": "pc-word-reopen.mp3",
      "audioSeconds": 8.232,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/pc-word-reopen-verified.png",
      "endScreenshotSha256": "49b866042feb9e3a87bba24793c30b03a718102b6d7c7109a25338751debeae2"
    },
    {
      "id": "sheet-open",
      "index": 5,
      "title": "打开项目预算表",
      "chapter": "02 表格与计算",
      "narration": "回到首页，点击打开，选择准备好的项目预算表。先看项目、数量、单价和预算四列数据。",
      "startFrame": 1138,
      "endFrame": 1350,
      "start": 56.9,
      "end": 67.5,
      "audio": "pc-sheet-open.mp3",
      "audioSeconds": 8.856,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/pc-sheet-open-verified.png",
      "endScreenshotSha256": "c34c5f690275e757792f1e06ee7008e34e9e76275222b24b42c41cb5081c58a1"
    },
    {
      "id": "sheet-formula",
      "index": 6,
      "title": "输入求和公式",
      "chapter": "02 表格与计算",
      "narration": "在名称框输入 D 五，选中合计单元格。点击公式栏，输入等于 S U M，括号内填写 D 二冒号 D 四，按回车，合计得到两千三百六十。",
      "startFrame": 1350,
      "endFrame": 1640,
      "start": 67.5,
      "end": 82,
      "audio": "pc-sheet-formula.mp3",
      "audioSeconds": 12.768,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/pc-sheet-formula-verified.png",
      "endScreenshotSha256": "895e1087d1f6bc4755fa7ab52607e21989cc38651d16d95cdccac4ee460a2370"
    },
    {
      "id": "sheet-save",
      "index": 7,
      "title": "自适应列宽并另存",
      "chapter": "02 表格与计算",
      "narration": "点击自适应列宽，按当前内容调整工作表。再点击另存为，把可编辑的预算表保存为海豹表格格式。",
      "startFrame": 1640,
      "endFrame": 1868,
      "start": 82,
      "end": 93.4,
      "audio": "pc-sheet-save.mp3",
      "audioSeconds": 9.696,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/pc-sheet-save-verified.png",
      "endScreenshotSha256": "c638a21ad4b3ed8e9fad9898d82b1329e09f4e45abca915e0f3d3b1e3e4db9f5"
    },
    {
      "id": "template-open",
      "index": 8,
      "title": "预览完整演示模板",
      "chapter": "03 演示模板",
      "narration": "在首页进入演示模板市场，选择精选推荐。点击模板封面查看完整页面，确认主题配图和内容布局。",
      "startFrame": 1868,
      "endFrame": 2103,
      "start": 93.4,
      "end": 105.15,
      "audio": "pc-template-open.mp3",
      "audioSeconds": 10.008,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/pc-template-open-verified.png",
      "endScreenshotSha256": "9ddd8a4510290f0ad7aed18823ae1ed676cce87769fed163efd856a896c09e80"
    },
    {
      "id": "template-use",
      "index": 9,
      "title": "创建可编辑的演示副本",
      "chapter": "03 演示模板",
      "narration": "点击使用并编辑副本，进入演示编辑器。点击左侧第二页查看内容，各页保留独立的文本、图形和图片。",
      "startFrame": 2103,
      "endFrame": 2335,
      "start": 105.15,
      "end": 116.75,
      "audio": "pc-template-use.mp3",
      "audioSeconds": 9.888,
      "endScreenshot": "release/promo/work-2.1.2-tutorial/pc-template-use-verified.png",
      "endScreenshotSha256": "04a9c1a2a52e773445055f048596a9ec6f5c08fc68ce7fba97696bfc847f9643"
    },
    {
      "id": "mindmap-create",
      "index": 10,
      "title": "创建独立脑图项目",
      "chapter": "04 脑图与流程图",
      "narration": "回到首页打开脑图，点击新建脑图项目，输入新品发布计划，再点击创建项目。每个项目分别保存。",
      "startFrame": 2335,
      "endFrame": 2563,
      "start": 116.75,
      "end": 128.15,
      "audio": "pc-mindmap-create.mp3",
      "audioSeconds": 9.456,
