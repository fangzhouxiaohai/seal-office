      "endScreenshotSha256": "e35c9ddc568a4bd476a5e0bf45a1a5fa67e8d5abefeeca2295f3003af8b0d85d"
    },
    {
      "id": "mindmap-edit",
      "index": 11,
      "title": "修改主题并增加分支",
      "chapter": "04 脑图与流程图",
      "narration": "在节点编辑区修改主题文字，再添加一个分支，填写产品资料。画布和本机保存状态会随实际编辑更新。",
      "startFrame": 2563,
      "endFrame": 2811,
      "start": 128.15,
