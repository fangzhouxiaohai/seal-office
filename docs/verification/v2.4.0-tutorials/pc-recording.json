  "steps": [
    {
      "id": "skins-open",
      "index": 0,
      "title": "打开新增的皮肤市场",
      "chapter": "01 皮肤市场",
      "narration": "海豹办公二点四新增皮肤市场。从首页左侧进入皮肤市场，内置十套皮肤，每张卡片同时展示浅色和深色两种效果。",
      "startFrame": 0,
      "endFrame": 264,
      "start": 0,
      "end": 13.2,
      "audio": "pc-skins-open.mp3",
      "audioSeconds": 11.472,
      "endScreenshot": "release/promo/work-2.4.0-tutorial/pc-skins-open-verified.png",
      "endScreenshotSha256": "fb7497bab436e598049745f8b4222dd6cad18e279e3e053e45b577fe8e31d438"
    },
    {
      "id": "skins-apply",
      "index": 1,
      "title": "预览并应用深海蓝",
      "chapter": "01 皮肤市场",
      "narration": "把鼠标停在预览按钮上，界面临时换上这套配色，移开后自动还原。点击应用深海蓝，整个界面立即换成新的主色。",
      "startFrame": 264,
      "endFrame": 518,
      "start": 13.2,
      "end": 25.9,
      "audio": "pc-skins-apply.mp3",
      "audioSeconds": 10.992,
      "endScreenshot": "release/promo/work-2.4.0-tutorial/pc-skins-apply-verified.png",
      "endScreenshotSha256": "5dd89d430d23f8f57c586ffb70861d9994d7fbe50b597dcb3b1f53d909ebbee1"
    },
    {
      "id": "skins-rules",
      "index": 2,
      "title": "查看皮肤开发规则",
      "chapter": "01 皮肤市场",
      "narration": "开发规则列出了皮肤文件格式和可读性要求，可以下载模板自己制作。导入的皮肤只在本机生效，公开给所有人需要管理员审核。最后切回默认的海豹紫。",
      "startFrame": 518,
      "endFrame": 840,
      "start": 25.9,
      "end": 42,
      "audio": "pc-skins-rules.mp3",
      "audioSeconds": 14.4,
      "endScreenshot": "release/promo/work-2.4.0-tutorial/pc-skins-rules-verified.png",
      "endScreenshotSha256": "97f6d2c47d6e0f94a520fc3f027dcf62489525ac125817dd4da4efe01fde2d77"
    },
    {
      "id": "new-word",
      "index": 3,
      "title": "新建一份工作计划",
      "chapter": "02 文字与截图粘贴",
      "narration": "先从首页点击新建，选择文字文档。下面从一份空白文档开始，完成输入、保存和重新打开。",
      "startFrame": 840,
      "endFrame": 1056,
      "start": 42,
      "end": 52.8,
      "audio": "pc-new-word.mp3",
      "audioSeconds": 9.072,
      "endScreenshot": "release/promo/work-2.4.0-tutorial/pc-new-word-verified.png",
      "endScreenshotSha256": "7467b3bc21b930252b3717f4f9cf4f82f55f45f88e3a50172a606da9b84c4c34"
    },
    {
      "id": "word-title",
      "index": 4,
      "title": "输入标题",
      "chapter": "02 文字与截图粘贴",
