  "steps": [
    {
      "id": "navigation",
      "index": 0,
      "title": "从服务页找到工具",
      "chapter": "01 功能入口",
      "narration": "移动端底部是首页、云盘、服务、模板和我的五个功能页。点击服务，在搜索框输入脑图，就能找到对应入口。",
      "startFrame": 0,
      "endFrame": 248,
      "start": 0,
      "end": 12.4,
      "audio": "android-navigation.mp3",
      "audioSeconds": 10.68,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/android-navigation-verified.png",
      "endScreenshotSha256": "430c4071a3e94cb0696f82724fdb5df3f9d0185c0f32d9b3b0455a891d57fce1"
    },
    {
      "id": "skins",
      "index": 1,
      "title": "手机上切换皮肤",
      "chapter": "02 皮肤市场",
      "narration": "在服务页点击皮肤市场，选择樱花粉并应用，手机界面立即换色；菜单选中态与输入边框跟随皮肤，随时可以切回默认的海豹紫。",
      "startFrame": 248,
      "endFrame": 520,
      "start": 12.4,
      "end": 26,
      "audio": "android-skins.mp3",
      "audioSeconds": 11.856,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/android-skins-verified.png",
      "endScreenshotSha256": "654c820e1ada351fa11e2d6f1fb66819c54f24a980fde8fa5777b8a3405fbfb3"
    },
    {
      "id": "new-word",
      "index": 2,
      "title": "新建文字文档",
      "chapter": "03 文字与保存",
      "narration": "返回首页，进入服务页，选择文字。打开后直接输入标题和正文，当前输入区会显示紫色轮廓。",
      "startFrame": 520,
      "endFrame": 743,
      "start": 26,
      "end": 37.15,
      "audio": "android-new-word.mp3",
      "audioSeconds": 9.384,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/android-new-word-verified.png",
      "endScreenshotSha256": "aaab4df8b0146898c793262daa85fb48a06cbf70d9922286d0362f4c975a074b"
    },
    {
      "id": "word-body",
      "index": 3,
      "title": "逐字填写工作计划",
      "chapter": "03 文字与保存",
      "narration": "先写每周工作计划，再逐段填写资料整理、预算核对和交付安排。这里展示的输入都实际写入文档。",
      "startFrame": 744,
      "endFrame": 1012,
      "start": 37.2,
      "end": 50.6,
      "audio": "android-word-body.mp3",
      "audioSeconds": 9.648,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/android-word-body-verified.png",
      "endScreenshotSha256": "5819d9e9856e500ccc24ce6fd0ec090c36f431b32c0e48a4104e7a16f58ffc0a"
    },
    {
      "id": "word-save",
      "index": 4,
      "title": "保存海豹文字文件",
      "chapter": "03 文字与保存",
      "narration": "点击保存，将这份计划保存为海豹文字格式。保存后仍可继续编辑，文件内容和当前格式一起保留。",
      "startFrame": 1012,
      "endFrame": 1246,
      "start": 50.6,
      "end": 62.3,
      "audio": "android-word-save.mp3",
      "audioSeconds": 9.96,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/android-word-save-verified.png",
      "endScreenshotSha256": "4db414e361d1702b830c99b79c453c71b8183032e5ecd08498678fef501de548"
    },
    {
      "id": "reading-enter",
      "index": 5,
      "title": "进入隐藏工具栏的阅读模式",
      "chapter": "04 全屏阅读",
      "narration": "打开准备好的长文档，点击全屏阅读。进入后顶部和底部操作栏默认隐藏，页面空间留给正文。",
      "startFrame": 1246,
      "endFrame": 1464,
      "start": 62.3,
      "end": 73.2,
      "audio": "android-reading-enter.mp3",
      "audioSeconds": 9.168,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/android-reading-enter-verified.png",
      "endScreenshotSha256": "da73fcd8929a1cab21f707ca7f08948caf6a2ce894f282c6fb568ac59e9aa77b"
    },
    {
      "id": "reading-swipe",
      "index": 6,
      "title": "左右滑动翻页",
      "chapter": "04 全屏阅读",
      "narration": "在正文中向左滑动，切换到下一页；向右滑动可以返回上一页。紫色轮廓标出当前阅读区域。",
      "startFrame": 1464,
      "endFrame": 1677,
      "start": 73.2,
      "end": 83.85,
      "audio": "android-reading-swipe.mp3",
      "audioSeconds": 8.928,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/android-reading-swipe-verified.png",
      "endScreenshotSha256": "f16b76924a9e57464567a000a5344418679d9893cc34df029ca7bb0efa1e346b"
    },
    {
      "id": "reading-controls",
      "index": 7,
      "title": "双击唤出，三秒后收起",
      "chapter": "04 全屏阅读",
      "narration": "双击页面，唤出顶部和底部工具栏。停止操作约三秒后，工具栏自动收起，继续专心阅读。",
      "startFrame": 1677,
      "endFrame": 1889,
      "start": 83.85,
      "end": 94.45,
      "audio": "android-reading-controls.mp3",
      "audioSeconds": 8.856,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/android-reading-controls-verified.png",
      "endScreenshotSha256": "d43c0052247fd61db2019be6c2e201fb992ebcffea61d7597bc8cdac4f010249"
    },
    {
      "id": "reading-zoom",
      "index": 8,
      "title": "双指缩放阅读内容",
      "chapter": "04 全屏阅读",
      "narration": "双指向外展开，放大阅读内容。需要退出时，再双击页面唤出工具栏，点击返回，回到原文档。",
      "startFrame": 1889,
      "endFrame": 2118,
      "start": 94.45,
      "end": 105.9,
