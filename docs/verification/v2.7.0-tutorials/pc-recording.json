  "steps": [
    {
      "id": "skins-open",
      "index": 0,
      "title": "打开新增的皮肤市场",
      "chapter": "01 皮肤市场",
      "narration": "海豹办公二点七延续可换色的工作界面。从首页左侧进入皮肤市场，查看十套皮肤，每张卡片都能预览浅色与深色效果。",
      "startFrame": 0,
      "endFrame": 267,
      "start": 0,
      "end": 13.35,
      "audio": "pc-skins-open.mp3",
      "audioSeconds": 11.64,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/pc-skins-open-verified.png",
      "endScreenshotSha256": "4e2f4c6698b769912e37b5ad41adbedbd2b6659a97f16a497a7e10f5de2fed3d"
    },
    {
      "id": "skins-apply",
      "index": 1,
      "title": "预览并应用深海蓝",
      "chapter": "01 皮肤市场",
      "narration": "把鼠标停在预览按钮上，界面临时换上这套配色，移开后自动还原。点击应用深海蓝，菜单选中态和输入边框也会随当前皮肤改变。",
      "startFrame": 267,
      "endFrame": 555,
      "start": 13.35,
      "end": 27.75,
      "audio": "pc-skins-apply.mp3",
      "audioSeconds": 12.672,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/pc-skins-apply-verified.png",
      "endScreenshotSha256": "d41a873d3913c6d98d3ab76da70445c1a35a592f1cfacd14a0ebfb81d9ee22a9"
    },
    {
      "id": "skins-rules",
      "index": 2,
      "title": "查看皮肤开发规则",
      "chapter": "01 皮肤市场",
      "narration": "开发规则列出了皮肤文件格式和可读性要求，可以下载模板自己制作。导入的皮肤只在本机生效，公开给所有人需要管理员审核。最后切回默认的海豹紫。",
      "startFrame": 556,
      "endFrame": 878,
      "start": 27.8,
      "end": 43.9,
      "audio": "pc-skins-rules.mp3",
      "audioSeconds": 14.4,
      "endScreenshot": "release/promo/work-2.7.0-tutorial/pc-skins-rules-verified.png",
      "endScreenshotSha256": "bd1e1d3d6ee8b55c5399ac5aa6ebaef8febd55ad3937392df9f8bef0d1feda95"
    },
    {
      "id": "new-word",
      "index": 3,
      "title": "新建一份工作计划",
      "chapter": "02 文字与截图粘贴",
      "narration": "先从首页点击新建，选择文字文档。下面从一份空白文档开始，完成输入、保存和重新打开。",
      "startFrame": 879,
      "endFrame": 1095,
      "start": 43.95,
      "end": 54.75,
      "audio": "pc-new-word.mp3",
      "audioSeconds": 9.072,
