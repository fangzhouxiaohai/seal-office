# 与云服务共用一个站点时，保留现有 /api 反向代理，并添加以下静态路径。
# alias 改为 build:web 生成的 mobile/unpackage/web 目录（必须以 / 结尾）。
location = /office { return 301 /office/; }
location ^~ /office/ {
    alias /var/www/seal-office-web/;
    index index.html;
    try_files $uri $uri/ /office/index.html;
    # Keep bundled Chinese font downloads within the PDF loading budget.
    # Older panel mime.types files otherwise serve TTF/OTF as uncompressed octet streams.
    types {
        text/html html;
        application/javascript js mjs;
        text/css css;
        application/json json;
        application/manifest+json webmanifest;
        application/wasm wasm;
        font/ttf ttf;
        font/otf otf;
        font/woff woff;
        font/woff2 woff2;
        image/png png;
        image/jpeg jpg jpeg;
        image/webp webp;
        image/gif gif;
        image/svg+xml svg;
        image/x-icon ico;
        text/plain txt;
        application/pdf pdf;
    }
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/javascript text/javascript text/css application/json application/manifest+json image/svg+xml font/ttf font/otf;
    # 当前版本文件名有固定项；刷新时必须重新验证，避免跨版本混用。
    add_header Cache-Control "no-cache" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    # blob 用于本地文档/图片和 PDF worker；HTTPS/WSS 用于用户配置的外部服务。
    # 仅本 location 覆盖 CSP，后台继续采用原有策略。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'" always;
}
# 云 API 必须通过同源 /api/ 提供；不要用通配 CORS 暴露带账号的接口。
# 普通云账号文档转换：20 MiB 二进制经 base64/JSON 传送，保留 120s 代理超时。
location ^~ /api/v1/conversion/ {
    proxy_pass http://127.0.0.1:8096/v1/conversion/;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host $host;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    client_max_body_size 30m;
}
