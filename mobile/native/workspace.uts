// Only the bundled entry document can receive the native bridge or replace the workspace.
// Image/font/API errors must not tear down a successfully loaded document.
export function isWorkspaceDocument(url: string): boolean {
  const path = url.split('?')[0].split('#')[0]
  return (path.startsWith('/') || path.startsWith('file://') || path.startsWith('resource://rawfile/')) && path.endsWith('/static/office/index.html')
}

// Harmony web-view emits JSON.parse(...).data as an ordinary object. Calling
// UTSJSONObject.getString/getBoolean on that object throws before dispatch.
// Indexed access also works on Android's UTSJSONObject implementation.
export function messageString(message: UTSJSONObject, key: string, fallback: string = ''): string {
  const value = message[key]
  return typeof value == 'string' ? value as string : fallback
}

export function messageBoolean(message: UTSJSONObject, key: string, fallback: boolean = false): boolean {
  const value = message[key]
  return typeof value == 'boolean' ? value as boolean : fallback
}

export function messageNumber(message: UTSJSONObject, key: string, fallback: number = 0): number {
  const value = message[key]
  return typeof value == 'number' ? value as number : fallback
}

export function onUIThread(task: () => void) {
  // #ifdef APP-ANDROID
  UTSAndroid.getUniActivity()?.runOnUiThread(task)
  // #endif
  // #ifndef APP-ANDROID
  task()
  // #endif
}

/**
 * Android 的 uni.request 与鸿蒙的 @ohos.net.http 都没有 PATCH 常量。
 * 把 PATCH 落成原生可用的 POST，并附带方法覆盖头，由服务端还原真实语义；
 * 这样重命名、移动、标签改名等写操作才不会被降级成读取请求。
 */
export function transportMethod(method: string): string {
  return method == 'PATCH' ? 'POST' : method
}

/** 在已有请求头上补充方法覆盖头，不修改调用方传入的对象。 */
export function methodOverrideHeaders(headers: UTSJSONObject, original: string): UTSJSONObject {
  const result = {} as UTSJSONObject
  headers.toMap().forEach((value: any, key: string) => {
    if (key.toLowerCase() != 'x-seal-method-override') result[key] = value
  })
  if (original == 'PATCH') result['X-Seal-Method-Override'] = 'PATCH'
  return result
}
