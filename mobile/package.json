{
  "name": "seal-office-uniapp-x",
  "version": "2.2.2",
  "private": true,
  "description": "海豹办公 uni-app x：Android、iOS、HarmonyOS、移动 H5 与 PC Web",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs android",
    "build:android": "node scripts/build.mjs android",
    "build:web": "node scripts/build.mjs web",
    "build:ios": "node scripts/build.mjs ios",
    "build:harmony": "node scripts/build.mjs harmony",
    "pack": "node scripts/pack.mjs",
    "pack:android": "node scripts/pack.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "check:android": "node scripts/native-check.mjs",
    "check:harmony": "node scripts/native-check.mjs --harmony",
    "check:apk": "node scripts/apk-check.mjs",
    "check:hap": "node scripts/hap-check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:regressions": "node scripts/browser-check.mjs --regressions",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "buffer": "6.0.3",
    "html-to-image": "1.11.13",
    "pako": "2.1.0",
    "path-browserify": "1.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5"
  }
}
