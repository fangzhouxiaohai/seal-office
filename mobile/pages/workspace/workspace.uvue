<template>
  <view class="workspace" :style="{ paddingTop: safeTop + 'px', paddingBottom: safeBottom + 'px', paddingLeft: safeLeft + 'px', paddingRight: safeRight + 'px' }">
    <web-view v-if="errorText.length == 0" id="seal-office" class="office" :src="source" :fullscreen="false" @load="onLoaded" @message="onMessage" @error="onError" @didterminate="reloadOffice" />
    <view v-else class="error-panel">
      <text class="error-title">海豹办公暂时无法打开</text>
      <text class="error-detail">{{ errorText }}</text>
      <button @click="reloadOffice">重新打开</button>
    </view>
  </view>
</template>

<script lang="uts">
import { exportDocument, printDocument } from '../../native/export.uts'
import { isWorkspaceDocument, onUIThread, messageString, messageBoolean, messageNumber } from '../../native/workspace.uts'
export default {
  data() {
    return {
      source: '/static/office/index.html?native=1',
      errorText: '',
      alive: true,
      token: Date.now().toString() + '-' + Math.random().toString() + '-' + Math.random().toString(),
      atHome: true,
      workspaceReady: false,
      loadErrorSerial: 0,
      unsaved: 0,
      safeTop: 0,
      safeBottom: 0,
      safeLeft: 0,
      safeRight: 0,
      tasks: new Map<string, RequestTask>()
    }
  },
  onLoad() {
    uni.$on('seal-persist-workspace', this.persistWorkspace)
  },
  onReady() { this.updateSafeArea() },
  onResize() { this.updateSafeArea() },
  onUnload() {
    this.alive = false
    uni.$off('seal-persist-workspace', this.persistWorkspace)
    this.tasks.forEach((task: RequestTask) => { task.abort() })
    this.tasks.clear()
  },
  onBackPress(): boolean {
    this.persistWorkspace()
    if (this.errorText.length > 0 || !this.workspaceReady) this.moveToBackground()
    else this.evaluate("window.dispatchEvent(new Event('seal-native-back',{cancelable:true}))")
    // Do not let ArkWeb navigate the local HTML history or terminate the ability.
    // The web layer acknowledges root Back after closing overlays and saving state.
    return true
  },
  methods: {
    moveToBackground() {
      // #ifdef APP-ANDROID
      UTSAndroid.getUniActivity()?.moveTaskToBack(true)
      // #endif
      // #ifdef APP-HARMONY
      UTSHarmony.getUIAbilityContext().moveAbilityToBackground().catch((_) => { uni.showToast({ title: '暂时无法返回桌面，请重试', icon: 'none' }) })
      // #endif
    },
    updateSafeArea() {
      const insets = uni.getWindowInfo().safeAreaInsets
      this.safeTop = insets.top
      this.safeBottom = insets.bottom
      this.safeLeft = insets.left
      this.safeRight = insets.right
    },
    evaluate(script: string) {
      // #ifdef APP
      // 网络、分块和文件回调可能运行在后台线程。全部脚本统一切回 UI 线程。
      onUIThread(() => { if (this.alive && this.errorText.length == 0) uni.createWebViewContext('seal-office', this)?.evalJS(script) })
      // #endif
    },
    persistWorkspace() { this.evaluate("window.dispatchEvent(new Event('seal-persist-workspace'))") },
    reply(message: UTSJSONObject) {
      const json = JSON.stringify(message)
      this.evaluate('window.sealReceiveNative && window.sealReceiveNative(' + json + ')')
    },
    onLoaded(event: UniWebViewLoadEvent) {
      // 只有安装包内的办公页面能够获得原生接口。
      const src = event.detail.src
      if (!isWorkspaceDocument(src)) return
      let platform = 'web'
      // #ifdef APP-ANDROID
      platform = 'android'
      // #endif
      // #ifdef APP-IOS
      platform = 'ios'
      // #endif
      // #ifdef APP-HARMONY
      platform = 'harmony'
      // #endif
      const config: UTSJSONObject = { token: this.token, platform: platform }
      this.evaluate('window.sealNative=' + JSON.stringify(config) + ";window.dispatchEvent(new Event('seal-native-ready'))")
    },
    onError(event: UniWebViewErrorEvent) {
      const url = event.detail.fullUrl.length > 0 ? event.detail.fullUrl : event.detail.src
      console.warn('办公 WebView 加载错误', event.detail.errCode, url.split('?')[0])
      if (!isWorkspaceDocument(url)) return
      const detail = '本地工作台加载失败（' + event.detail.errCode.toString() + '），请重新打开'
      if (!this.workspaceReady) { this.errorText = detail; return }
      // Some ArkWeb subframe/resource failures report the entry URL as src.
      // Probe the live app before replacing it with a full-screen error page.
      const serial = ++this.loadErrorSerial
      this.evaluate("window.dispatchEvent(new Event('seal-native-probe'))")
      setTimeout(() => { if (this.alive && this.loadErrorSerial == serial) this.errorText = detail }, 1500)
    },
    reloadOffice() { this.workspaceReady = false; this.loadErrorSerial++; this.errorText = ''; this.source = '/static/office/index.html?native=1&reload=' + Date.now().toString() },
    onMessage(event: UniWebViewMessageEvent) {
      event.detail.data.forEach((message: UTSJSONObject) => {
        if (message == null || messageString(message, 'token') != this.token) return
        const action = messageString(message, 'action')
        if (action == 'state') { this.workspaceReady = true; this.atHome = messageBoolean(message, 'atHome'); this.unsaved = messageNumber(message, 'unsaved'); return }
        if (action == 'healthy') { this.loadErrorSerial++; return }
        if (action == 'back-root') { this.moveToBackground(); return }
        const id = messageString(message, 'id')
        if (id.length == 0 || id.length > 100) return
        try {
        if (action == 'ping') this.reply({ id: id, type: 'ready' })
        else if (action == 'abort') { this.tasks.get(id)?.abort(); this.tasks.delete(id) }
        else if (action == 'request') this.request(id, message)
        else if (action == 'save' || action == 'print') this.save(id, message)
        else if (action == 'font') this.font(id, messageString(message, 'family', 'sans'))
        else if (action == 'pick-files') this.pickFiles(id, messageBoolean(message, 'multiple'))
        else if (action == 'clipboard-write') {
          const text = messageString(message, 'text')
          if (text.length > 4194304) { this.reply({ id: id, type: 'error', error: '复制内容超过 4 MiB，请分段复制' }); return }
          uni.setClipboardData({ data: text, showToast: false,
            success: (_) => { this.reply({ id: id, type: 'written' }) },
            fail: (error) => { this.reply({ id: id, type: 'error', error: error.errMsg }) }
          })
        }
        else this.reply({ id: id, type: 'error', error: '当前原生接口不支持此操作，请更新应用' })
        } catch (_) {
          this.reply({ id: id, type: 'error', error: '系统操作未能启动，请重试；仍失败时请重新打开应用' })
        }
      })
    },
    request(id: string, message: UTSJSONObject) {
      const url = messageString(message, 'url')
      if (!url.startsWith('https://') && !url.startsWith('http://127.0.0.1:') && !url.startsWith('http://localhost:')) { this.reply({ id: id, type: 'error', error: '联网地址须使用 HTTPS' }); return }
      const body = message['body'] == null ? null : messageString(message, 'body')
      const data = body == null ? null : uni.base64ToArrayBuffer(body)
      const headers = (message['headers'] as UTSJSONObject | null) ?? {} as UTSJSONObject
      const stream = messageBoolean(message, 'stream')
      const task = uni.request<ArrayBuffer>({
        url: url,
        method: messageString(message, 'method', 'GET'),
        header: headers,
        data: data,
        responseType: 'arraybuffer',
        enableChunked: stream,
        timeout: stream ? 900000 : 60000,
        success: (response) => {
          this.reply({ id: id, type: 'end', status: response.statusCode, headers: response.header, data: response.data == null ? '' : uni.arrayBufferToBase64(response.data!) })
        },
        fail: (error) => { this.reply({ id: id, type: 'error', error: '网络请求失败：' + error.errMsg }) },
        complete: (_) => { onUIThread(() => { this.tasks.delete(id) }) }
      })
      task.onHeadersReceived((response) => { this.reply({ id: id, type: 'headers', status: response.statusCode, headers: response.header }) })
      task.onChunkReceived((chunk) => { this.reply({ id: id, type: 'chunk', data: uni.arrayBufferToBase64(chunk.data) }) })
      this.tasks.set(id, task)
    },
    font(id: string, family: string) {
      uni.getFileSystemManager().readFile({
        filePath: '/static/office/fonts/' + (family == 'serif' ? 'NotoSerifCJKsc-Regular.otf' : 'NotoSansSC.ttf'), encoding: 'base64',
        success: (result) => {
          const data = result.data as string
          // base64 分段必须以 4 字符为边界。
          for (let start = 0; start < data.length; start += 32768) this.reply({ id: id, type: 'chunk', data: data.slice(start, start + 32768) })
          this.reply({ id: id, type: 'end' })
        },
        fail: (error) => { this.reply({ id: id, type: 'error', error: error.errMsg }) }
      })
    },
    pickFiles(id: string, multiple: boolean) {
      uni.chooseFile({ type: 'all', count: multiple ? 20 : 1,
        success: (result) => {
          let total = 0
          result.tempFiles.forEach((file: ChooseFileTempFile) => { total += file.size })
          if (total > 104857600) { this.reply({ id: id, type: 'error', error: '一次导入的文件总大小不能超过 100 MiB' }); return }
          this.readPickedFile(id, result.tempFiles, 0, 0)
        },
        fail: (error) => { this.reply({ id: id, type: error.errCode == 1101001 || error.errMsg.toLowerCase().includes('cancel') ? 'cancel' : 'error', error: error.errMsg }) }
      })
    },
    readPickedFile(id: string, files: ChooseFileTempFile[], index: number, transferred: number) {
      if (index >= files.length) { this.reply({ id: id, type: 'end' }); return }
      const file = files[index]
      if (file.size > 104857600) { this.reply({ id: id, type: 'error', error: '单个文件不能超过 100 MiB' }); return }
      uni.getFileSystemManager().readFile({ filePath: file.path, encoding: 'base64',
        success: (result) => {
          const data = result.data as string
          if (data.length > 139810136) { this.reply({ id: id, type: 'error', error: '单个文件不能超过 100 MiB' }); return }
          const nextSize = transferred + Math.floor(data.length * 3 / 4)
          if (nextSize > 104857602) { this.reply({ id: id, type: 'error', error: '一次导入的文件总大小不能超过 100 MiB' }); return }
          this.reply({ id: id, type: 'file-start', name: file.name, size: file.size })
          for (let start = 0; start < data.length; start += 32768) this.reply({ id: id, type: 'chunk', data: data.slice(start, start + 32768) })
          this.reply({ id: id, type: 'file-end' })
          this.readPickedFile(id, files, index + 1, nextSize)
        },
        fail: (error) => { this.reply({ id: id, type: 'error', error: error.errMsg }) }
      })
    },
    save(id: string, message: UTSJSONObject) {
      const name = messageString(message, 'name', '文档').replace(/[\\/:*?"<>|\u0000-\u001f]/g, '_')
      const data = messageString(message, 'data')
      if (data.length > 150000000 || name.length > 240) { this.reply({ id: id, type: 'error', error: '文件过大或名称过长' }); return }
      let directory = uni.env.USER_DATA_PATH
      // #ifdef APP-HARMONY
      directory = UTSHarmony.getUIAbilityContext().cacheDir
      // #endif
      const filename = directory + '/seal-export-' + Date.now().toString() + '-' + name
      uni.getFileSystemManager().writeFile({
        filePath: filename, data: data, encoding: 'base64',
        success: (_) => {
          onUIThread(() => {
            const done = (status: string, path: string, error: string) => { this.reply({ id: id, type: status, path: path, error: error }) }
            if (messageString(message, 'action') == 'print') printDocument(filename, done)
            else exportDocument(filename, name, messageString(message, 'mime', 'application/octet-stream'), done)
          })
        },
        fail: (error) => { this.reply({ id: id, type: 'error', error: error.errMsg }) }
      })
    }
  }
}
</script>

<style>
.workspace { flex: 1; width: 100%; height: 100%; background-color: #F5F7FA; }
.office { flex: 1; width: 100%; height: 100%; }
.error-panel { flex: 1; justify-content: center; align-items: center; padding: 24px; }
.error-title { font-size: 20px; color: #202A3D; margin-bottom: 16px; }
.error-detail { font-size: 14px; color: #667085; margin-bottom: 24px; }
</style>
