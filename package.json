{
  "name": "seal-office",
  "version": "2.3.0",
  "description": "海豹办公 Seal Office",
  "homepage": "https://github.com/fangzhouxiaohai/seal-office",
  "main": "main/main.js",
  "author": "饮风一笑",
  "license": "MIT",
  "scripts": {
    "start": "concurrently -k \"npm run dev\" \"npm run electron:dev\"",
    "dev": "vite",
    "electron:dev": "electron .",
    "build": "vite build && node scripts/generate-integrity.cjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run && vitest run --config vitest.main.config.js && npm run test:packaging",
    "test:main": "vitest run --config vitest.main.config.js",
    "test:packaging": "node --test scripts/generate-integrity.test.cjs scripts/artifact-names.test.cjs scripts/retain-web-session-assets.test.cjs",
    "typecheck": "tsc --noEmit",
    "icons:files": "electron build/make-file-icons.cjs",
    "pack": "npm --prefix mobile run pack:android",
    "dist": "npm --prefix mobile run pack:android",
    "prepare:office-runtime": "python scripts/prepare-office-runtime.py",
    "release:prepare": "node scripts/release-layout.cjs --prune",
    "promo:build": "node scripts/promo/build-current.cjs",
    "pack:windows": "npm run release:prepare && npm run prepare:office-runtime && npm run build && electron-builder --win --dir",
    "dist:windows": "npm run release:prepare && npm run prepare:office-runtime && npm run build && electron-builder --win",
    "dist:windows:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1",
    "mobile:dev": "npm --prefix mobile run dev",
    "mobile:build": "npm --prefix mobile run build:android",
    "mobile:pack": "npm --prefix mobile run pack:android",
    "web:dev": "npm --prefix mobile run dev",
    "web:build": "npm --prefix mobile run build:web",
    "mobile:check": "npm --prefix mobile run check",
    "pack:ubuntu": "npm run release:prepare && npm run build && electron-builder --config build/electron-ubuntu.cjs --linux --dir --publish never",
    "dist:ubuntu": "npm run release:prepare && npm run build && electron-builder --config build/electron-ubuntu.cjs --linux --dir --x64 --publish never && node scripts/package-deb-on-windows.cjs",
    "package:ubuntu:windows": "node scripts/package-deb-on-windows.cjs"
  },
  "dependencies": {
    "@formulajs/formulajs": "4.6.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@ycsx/ofdjs": "1.0.6",
    "antd": "^5.0.0",
    "docx": "^8.5.0",
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.12.0",
    "html-to-pdfmake": "^2.1.0",
    "iconv-lite": "0.6.3",
    "jszip": "^3.10.2",
    "lowlight": "^3.3.0",
    "mammoth": "^1.12.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfmake": "^0.2.15",
    "pptxgenjs": "^3.12.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sax": "^1.6.1",
    "ssf": "https://cdn.sheetjs.com/ssf-0.11.3/ssf-0.11.3.tgz",
    "unified": "^11.0.5",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.0.0",
    "electron": "^25.9.8",
    "electron-builder": "^26.15.3",
    "jsdom": "^22.1.0",
    "typescript": "^7.0.2",
    "vite": "^4.0.0",
    "vitest": "^0.34.6"
  },
  "build": {
    "beforePack": "build/prepare-shell-new.cjs",
    "appId": "com.sealoffice.desktop",
    "productName": "海豹办公",
    "directories": {
      "output": "release/v${version}",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "dist/**/*",
      "package.json",
      "!main/**/*.test.js",
      "!main/**/*.spec.js",
      "!main/main-test.js",
      "!main/**/node_modules/**",
      "!main/**/.vitest/**",
      "!main/**/__fixtures__/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": "海豹办公"
      },
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "mobile/web/public/fonts/NotoSansSC.ttf",
        "to": "fonts/NotoSansSC.ttf"
      },
      {
        "from": "mobile/web/public/fonts/OFL.txt",
        "to": "fonts/OFL.txt"
      },
      {
        "from": "mobile/web/public/fonts/NotoSerifCJKsc-Regular.otf",
        "to": "fonts/NotoSerifCJKsc-Regular.otf"
      },
      {
        "from": "mobile/web/public/fonts/NotoSerif-LICENSE.txt",
        "to": "fonts/NotoSerif-LICENSE.txt"
      },
      {
        "from": "build/office-runtime-notice.txt",
        "to": "office-runtime-notice.txt"
      },
      {
        "from": ".upgrade-private/office-runtime",
        "to": "office-runtime",
        "filter": [
          "**/*",
          "!*.msi",
          "!*.log"
        ]
      },
      {
        "from": "main/windows/shellIntegration.ps1",
        "to": "shell-integration/shellIntegration.ps1"
      },
      {
        "from": "main/windows/file-icons",
        "to": "file-icons",
        "filter": [
          "*.ico"
        ]
      },
      {
        "from": "build/shell-new",
        "to": "shell-new",
        "filter": [
          "blank.*"
        ]
      }
    ],
    "appx": {
      "applicationId": "SealOffice",
      "identityName": "45C56666.seal-office",
      "publisher": "CN=F6431C2A-EA55-468A-89D8-890511FCADF7",
      "publisherDisplayName": "星马软件",
      "displayName": "seal-office",
      "backgroundColor": "#2b6cf6",
      "languages": [
        "zh-CN"
      ],
      "capabilities": [
        "runFullTrust"
      ]
    },
    "npmRebuild": false,
    "portable": {
      "artifactName": "seal-office-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "seal-office-setup-${version}.exe",
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "海豹办公"
    },
    "electronDist": "node_modules/electron/dist",
    "compression": "normal"
  }
}
