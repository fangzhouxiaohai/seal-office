# Place inside an HTTPS virtual host. Forward /office-converter/ to the private service.
location /office-converter/ {
    proxy_pass http://127.0.0.1:8298/;
    client_max_body_size 28m;
    proxy_read_timeout 115s;
    proxy_send_timeout 115s;
    proxy_connect_timeout 5s;
    proxy_request_buffering on;
    # Do not log document payloads or authorization headers.
}
